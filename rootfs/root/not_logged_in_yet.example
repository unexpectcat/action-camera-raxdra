# Installed as /root/.not_logged_in_yet (mode 600): Armbian unattended first login.
PRESET_NET_CHANGE_DEFAULTS=0
PRESET_ROOT_PASSWORD="@ROOT_PASSWORD@"
PRESET_USER_NAME="@USER_NAME@"
PRESET_USER_PASSWORD="@USER_PASSWORD@"
PRESET_DEFAULT_REALNAME="Radxa"
PRESET_USER_SHELL=bash
PRESET_TIMEZONE="Europe/Kyiv"
PRESET_LOCALE="en_US.UTF-8"
